# ==============================================================================
# AI Document Assistant – Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==============================================================================

# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME="AI Document Assistant"
APP_ENV=development
DEBUG=true
SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_document
POSTGRES_USER=aid_user
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql+asyncpg://aid_user:CHANGE_ME_DB_PASSWORD@localhost:5432/ai_document

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0

# ── Qdrant ─────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=CHANGE_ME_QDRANT_KEY
QDRANT_COLLECTION_NAME=documents

# ── MinIO / S3 ─────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET_NAME=ai-documents
MINIO_SECURE=false

# ── Google Gemini ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ── Embedding Model ────────────────────────────────────────────────────────────
# Local model path or HuggingFace model ID
BGE_MODEL_NAME=BAAI/bge-m3
BGE_RERANKER_NAME=BAAI/bge-reranker-v2-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ── Document Processing ────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
MIN_CHUNK_SIZE_TOKENS=100
MAX_CHUNK_SIZE_TOKENS=1000

# ── RAG Retrieval ──────────────────────────────────────────────────────────────
DENSE_RETRIEVAL_TOP_K=20
SPARSE_RETRIEVAL_TOP_K=20
RERANKER_TOP_K=8

# ── Celery ─────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/1

# ── Frontend ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="AI Document Assistant"
